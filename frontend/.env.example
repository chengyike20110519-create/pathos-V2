# Explicit data mode. Production permits backend only.
PATHOS_DATA_MODE=backend

# Stage 5 uses a deterministic local Preview Bundle through the Next.js BFF.
PATHOS_PREVIEW_BUNDLE_DIR=./data/preview

# Reserved for the alternative HTTP transport. Not used by the Stage 5 bundle mode.
PATHOS_BACKEND_BASE_URL=
PATHOS_BACKEND_TIMEOUT_MS=8000

# Browser-facing requests stay on the same-origin BFF.
NEXT_PUBLIC_PATHOS_API_BASE_URL=/api/pathos/preview

# Stage 7B-A — Map Provider selection.
# Allowed values: "maplibre" (default) | "baidu"
# - "maplibre": the existing MapLibre raster basemap (CARTO Voyager /
#   Dark Matter). Always available, no external key required.
# - "baidu": loads the Baidu Map JSAPI GL when an AK is configured.
#   The host falls back to MapLibre if the AK is missing or invalid;
#   the request only succeeds after the user has added the current
#   domain (e.g. http://localhost:3002) to the Referer whitelist in
#   the Baidu Map console.
NEXT_PUBLIC_PATHOS_MAP_PROVIDER=maplibre

# Stage 7B-A — Baidu Map JSAPI AK. Required only when the provider
# flag above is "baidu". Leave blank to keep MapLibre as the active
# provider. Do NOT commit a real value; this is a placeholder.
NEXT_PUBLIC_BAIDU_MAP_AK=


# --- Supabase Postgres (Render Web Service backend) ---
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres
PATHOS_DB_POOL_MAX=10


# Canonical origin used by /sitemap.xml, JSON-LD, OpenGraph,
# and the robots.txt Sitemap: line. Defaults to the Render deployment
# if unset.
NEXT_PUBLIC_SITE_URL=https://personal-os-zu9q.onrender.com


# --- Public contact channels (src/lib/contact.ts) ---
# Every value is optional. When one is unset the UI renders nothing for
# that channel instead of a placeholder. Values that look like examples
# (anything containing "example", "changeme" or "TODO") are ignored on
# purpose, so a leftover placeholder cannot reach production.
NEXT_PUBLIC_SUPPORT_EMAIL=
NEXT_PUBLIC_SUPPORT_WECHAT_ID=
NEXT_PUBLIC_WECHAT_QR_URL=
NEXT_PUBLIC_SUPPORT_PHONE=
# Free-form, e.g. "周一至周五 10:00-19:00"
NEXT_PUBLIC_SUPPORT_HOURS=


# --- Commercial capability flags (src/lib/contact.ts) ---
# Set to "true" only once the matching system actually exists. Pricing,
# subscription and API pages read these instead of hard-coding claims,
# so we never promise invoices, webhooks or self-serve keys that
# nothing backs. Anything other than "true" counts as disabled.
PATHOS_FEATURE_ONLINE_PAYMENT=false
PATHOS_FEATURE_INVOICES=false
PATHOS_FEATURE_WEBHOOKS=false
PATHOS_FEATURE_SELF_SERVE_API_KEYS=false


# --- Report sharing (src/lib/report-access.ts) ---
# Share links expire after this many days. Unset falls back to the
# default in code. Revoking a link is always possible via
# DELETE /api/reports/[id].
PATHOS_REPORT_TOKEN_TTL_DAYS=


# --- Report generation limits (src/app/api/reports/generate/route.ts) ---
# Per-IP rate limits for report generation. Both fall back to the
# defaults in code when unset. The limiter is fail-closed: if the
# backing store is unreachable the request is rejected rather than
# waved through.
PATHOS_REPORTS_PER_MINUTE=
PATHOS_REPORTS_PER_DAY=
# Upstream AI call timeout for report generation, in milliseconds.
PATHOS_REPORT_AI_TIMEOUT_MS=


# --- Privacy ---
# Salt for hashing client IPs before they are written to rate-limit
# buckets and audit rows, so stored values are not reversible to a raw
# address. Set a long random string in production and do not rotate it
# casually: rotating resets in-flight rate-limit windows.
PATHOS_IP_HASH_SALT=
